generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(uuid())
  name       String
  pictureUrl String?
  team       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rsvps      GameRsvp[]
}

model Game {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teamAssignments String?
  goals           String?
  gameNumber      Int?     @unique
  teamChanges     String?
  gameEvents      String?
  sportsmanship   String?

  // Which field/turf the game was played on. "stadium" | "grass" |
  // "cancelled" | null. null = "N/A FIELD" in the UI.
  field           String?

  rsvps           GameRsvp[]
}

// Per-game RSVP from a player. Identity is the playerId (claimed via
// localStorage on anonymous devices, or via a Google-authed user's linked
// player). Unique on (gameId, playerId) so a player has at most one active
// RSVP per game; subsequent submissions overwrite.
model GameRsvp {
  id          String   @id @default(uuid())
  gameId      String
  playerId    String
  status      String   // "yes" | "maybe" | "no"
  guestCount  Int      @default(0)
  setByUserId String?  // null = self, or Google-authed admin user id when overridden
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([gameId])
}

model AppSettings {
  id         String   @id @default("singleton")
  guestCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  picture   String?
  role      String   @default("regular")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  playerId  String?  @unique
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("regular")
  createdAt DateTime @default(now())
}

model LegacyStat {
  id        String   @id @default(uuid())
  playerId  String
  season    String
  goals     Int      @default(0)
  assists   Int      @default(0)
  wins      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([playerId, season])
}

model FieldStat {
  id             String   @id @default(uuid())
  date           DateTime @unique
  year           Int
  played         String
  eviteResponse  Int?
  responseRate   Float
  showUp         Int?
  attendanceRate Float
  engagement     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  groupSize      Int?
  location       String?
  waIn           Int?
  waMaybe        Int?
  waOut          Int?
  waPlus1        Int?
  waPlus2        Int?

  @@index([year])
}

model UserAchievementSeen {
  userId        String
  achievementId String
  seenAt        DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(uuid())
  name       String
  pictureUrl String?
  team       String?  // "dark" or "white" or null
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Game {
  id        String   @id @default(uuid())
  gameNumber Int?     @unique // Persistent game number that doesn't change (nullable temporarily for migration)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Store game data as JSON
  // Team assignments: { playerId: "color" | "white" }
  teamAssignments String? // JSON string of Record<string, "color" | "white">
  
  // Goals: Array of { scorerId, assisterId?, timestamp, team }
  goals String? // JSON string of goal array
  
  // Team changes: Array of { playerId, timestamp, team, type, previousTeam?, newTeam? }
  teamChanges String? // JSON string of team change array

  // Game events: Array of { type: 'halfTime' | 'gameOver', timestamp }
  gameEvents String? // JSON string of game event array

  // Sportsmanship points per player: { playerId: number }
  sportsmanship String? // JSON string of Record<string, number>
}

model AppSettings {
  id          String   @id @default("singleton")
  guestCount  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  picture   String?
  role      String   @default("regular") // "admin" or "regular"
  playerId  String?  @unique // Link to a Player record
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("regular") // "admin" or "regular"
  createdAt DateTime @default(now())
}

model LegacyStat {
  id        String   @id @default(uuid())
  playerId  String
  season    String   // "2022-2023" or "2023-2024"
  goals     Int      @default(0)
  assists   Int      @default(0)
  wins      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([playerId, season])
}

model FieldStat {
  id             String   @id @default(uuid())
  date           DateTime
  year           Int
  played         String
  eviteResponse  Int?
  responseRate   Float
  showUp         Int?
  attendanceRate Float
  engagement     String?
  notes          String?
  // WhatsApp RSVP breakdown
  location       String?  // "stadium", "grass", or "turf"
  waIn           Int?     // "In" votes
  waPlus1        Int?     // "+1" votes (voter + 1 guest = 2 bodies)
  waPlus2        Int?     // "+2" votes (voter + 2 guests = 3 bodies)
  waMaybe        Int?     // "Maybe" votes
  waOut          Int?     // "Out" votes
  groupSize      Int?     // group size used as denominator for rates
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date])
  @@index([year])
}

// Tracks which achievement-unlock popups a user has already been shown.
// Used to diff "currently-earned" against "already-notified" so we can pop
// up only newly-earned achievements on app load.
model UserAchievementSeen {
  userId        String
  achievementId String
  seenAt        DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

// Session storage for connect-pg-simple. This table is created and managed
// by the session middleware, not the application code. It is declared here
// only so that `prisma db push` will not drop it during deploys.
model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(uuid())
  name       String
  pictureUrl String?
  team       String?
  phone      String?  @unique // E.164, used to attribute WhatsApp poll votes
  onRoster   Boolean  @default(true) // false = prior member (no longer on the current roster)
  isAlumni   Boolean  @default(false) // true = alumnus of the school; drives the alumni % figures
  // First dues year, hand-seeded: per-player rosters only exist from 2025 but
  // the club goes back to 2018, so tenure cannot be derived. Null = unknown,
  // which reads as "not yet entered" rather than "rookie".
  memberSince Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rsvps      GameRsvp[]
}

model Game {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teamAssignments String?
  goals           String?
  gameNumber      Int?     @unique
  teamChanges     String?
  gameEvents      String?
  sportsmanship   String?
  // Per-player foul counts, JSON Record<playerId, number>. Stored as positive
  // counts; net sportsmanship (sportsmanship - fouls) is computed at read time.
  fouls           String?

  // Which field/turf the game was played on. "stadium" | "grass" |
  // "cancelled" | null. null = "N/A FIELD" in the UI.
  field           String?

  // Kick-off, set by the start button. null = not started. This is NOT the game
  // date: createdAt remains the date everywhere in the app, and reading
  // startedAt in date logic would silently break every schedule and stat.
  startedAt       DateTime?

  rsvps           GameRsvp[]
  whatsappPolls   WhatsappPoll[]
  guestVisits     GuestVisit[]
}

// A guest who has actually turned up, tracked across games so recurring
// visitors resolve to one identity (and one dues count). Distinct from the
// GuestN pool Players, which are per-game slots reused by different humans.
model Guest {
  id             String   @id @default(uuid())
  name           String   // as typed, e.g. "Ricky B"
  // lower+trimmed. Unique on purpose: a split identity is a silently wrong
  // dues count, whereas two real Rickys just means typing a surname.
  normalizedName String   @unique
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  visits         GuestVisit[]
  duesPayments   DuesPayment[]
}

// What a dues year costs. One row per year. Exists because installments make
// "have they paid?" a comparison rather than a lookup — without an owed figure
// there is nothing to compare the sum of payments against.
//
// memberAmount is ENTERED, never computed from targetAmount ÷ roster: the owner
// sets the rate at season open and it is frozen for the year, so balances are
// knowable on day one. targetAmount only drives a progress bar.
model DuesYearConfig {
  duesYear      Int      @id // the calendar year covered, e.g. 2027
  targetAmount  Decimal  @db.Decimal(10, 2) // what the club needs, e.g. 6000.00
  memberAmount  Decimal  @db.Decimal(10, 2) // per billed member, e.g. 150.00
  guestGameRate Decimal  @db.Decimal(10, 2) // per billable guest game, e.g. 30.00
  openedAt      DateTime? // when collection opened and memberAmount was fixed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Who was on the hook in a given dues year, and for how much. Written when
// collection opens so the year's bill list stops moving — deriving it live from
// Player.onRoster would silently rewrite financial history every time someone
// is marked Former.
//
// amountOwed is CAPTURED per person, not derived: alumni are 0.00, mid-year
// joiners inside the last three months are the owner's discretion, and the 2028
// top-scorer / sportsmanship discounts land in this same field with no schema
// change.
model DuesRosterEntry {
  id         String    @id @default(uuid())
  duesYear   Int
  playerId   String
  amountOwed Decimal   @db.Decimal(10, 2) // 0.00 = exempt
  exemption  String?   // "alumni" | "discount:top_scorer" | … ; null = pays full
  note       String?   // per person per year, independent of any payment
  joinedAt   DateTime? // null = present when the year opened
  // Left the group during this dues year. Separate from `exemption` on purpose:
  // exemption is a pricing reason (alumni, and later the top-scorer discount),
  // leaving is a lifecycle event, and one must never overwrite the other.
  // Person-level fact is Player.onRoster = false; this is the per-year fact.
  leftAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([duesYear, playerId])
  @@index([duesYear])
  @@index([playerId])
}

// One payment event, against EITHER a Player or a Guest, never both. Several
// rows per person per dues year is the NORMAL case: installments are recorded
// as they arrive, not planned in advance.
model DuesPayment {
  id         String   @id @default(uuid())
  duesYear   Int
  playerId   String?
  guestId    String?
  amount     Decimal  @db.Decimal(10, 2)
  method     String   // "venmo" | "cash" | "paypal" | "zelle" | "other"
  paidAt     DateTime
  note       String?
  recordedBy String?  // admin userId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guest Guest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([duesYear])
  @@index([playerId])
  @@index([guestId])
}

// One guest appearance in one game. slotPlayerId is the GuestN pool Player
// that carries the guest through teamAssignments/goals/sportsmanship — it
// stays the in-game token, this row just says who was behind it and who
// brought them. Both player ids are plain strings, matching how the game JSON
// fields already store player references.
model GuestVisit {
  id           String   @id @default(uuid())
  gameId       String
  slotPlayerId String
  guestId      String?  // null = name skipped
  hostPlayerId String?  // null = host skipped / unknown
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game  Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@unique([gameId, slotPlayerId])
  @@index([gameId])
  @@index([guestId])
}

// Per-game RSVP from a player. Identity is the playerId (claimed via
// localStorage on anonymous devices, or via a Google-authed user's linked
// player). Unique on (gameId, playerId) so a player has at most one active
// RSVP per game; subsequent submissions overwrite.
model GameRsvp {
  id          String   @id @default(uuid())
  gameId      String
  playerId    String
  status      String   // "yes" | "maybe" | "no"
  guestCount  Int      @default(0)
  setByUserId String?  // null = self, or Google-authed admin user id when overridden
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([gameId])
}

model AppSettings {
  id         String   @id @default("singleton")
  guestCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  picture   String?
  role      String   @default("regular")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  playerId  String?  @unique
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("regular")
  createdAt DateTime @default(now())
}

model LegacyStat {
  id        String   @id @default(uuid())
  playerId  String
  season    String
  goals     Int      @default(0)
  assists   Int      @default(0)
  wins      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([playerId, season])
}

model FieldStat {
  id             String   @id @default(uuid())
  date           DateTime @unique
  year           Int
  played         String
  eviteResponse  Int?
  responseRate   Float
  showUp         Int?
  attendanceRate Float
  engagement     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  groupSize      Int?
  location       String?
  waIn           Int?
  waMaybe        Int?
  waOut          Int?
  waPlus1        Int?
  waPlus2        Int?

  @@index([year])
}

model UserAchievementSeen {
  userId        String
  achievementId String
  seenAt        DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// ── WhatsApp poll listener ──
// Read-only Baileys device syncs native WhatsApp poll votes into GameRsvp.
// See docs/whatsapp-poll-listener-spec.md. All gated by WHATSAPP_LISTENER_ENABLED.

// Persists Baileys auth state (creds + signal keys) across redeploys, since
// Render wipes the filesystem. One row per key; creds live under id "creds".
model WhatsappAuthState {
  id        String   @id // "creds" | "<keyType>-<keyId>"
  value     String   // JSON, BufferJSON-encoded (may contain Buffers)
  updatedAt DateTime @updatedAt
}

// A captured WhatsApp poll. Stores the original creation message (needed to
// decrypt votes, even after a restart) and the latest decoded aggregate so
// syncing to RSVPs is idempotent. gameId is null until matched/linked.
model WhatsappPoll {
  id            String   @id @default(uuid())
  pollMessageId String   @unique // WA message id of the poll
  remoteJid     String            // group chat id
  question      String            // poll title
  pollMessage   String            // BufferJSON-encoded { key, message } for decryption
  pollUpdates   String?           // BufferJSON-encoded proto.IPollUpdate[] (raw encrypted votes)
  latestVotes   String?           // JSON { "<phone>": "<optionText>" } — latest decoded aggregate
  gameId        String?           // matched game; null until linked
  linkedBy      String?           // null = auto-matched by date, else admin userId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game          Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([gameId])
}

// Directory of WhatsApp numbers we've seen, with their display name, so an
// admin resolving an unmatched vote knows whose number it is.
model WhatsappContact {
  phone     String   @id // digits only (JID user part)
  pushName  String?
  updatedAt DateTime @updatedAt
}

// Singleton config for the listener. groupJid scopes capture to one group
// chat; when null, the listener captures polls from any chat (unscoped).
model WhatsappSettings {
  id          String   @id @default("singleton")
  groupJid    String?  // scope capture to this group chat (null = any chat)
  titleFilter String?  // only capture polls whose title contains this text (null = any title)
  updatedAt   DateTime @updatedAt
}

# Database
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/awty_football?schema=public"
# For production (Railway/Render/etc will provide this):
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Server
PORT=4000

# Frontend URL (for CORS)
# Local development:
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://awtyfootballclub.com

# Backend URL (for OAuth callback)
# Local development:
BACKEND_URL=http://localhost:4000
# Production:
# BACKEND_URL=https://api.awtyfootballclub.com
# Or if using same domain:
# BACKEND_URL=https://awtyfootballclub.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Session Secret (generate a strong random string)
# Use: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-strong-random-secret

# Environment
NODE_ENV=development
# NODE_ENV=production

# WhatsApp listener auth store. Signal keys rotate constantly; keeping them in
# Postgres held the Neon compute awake and exhausted the monthly compute quota
# (outage 2026-07-29). Set REDIS_URL and the listener stores them in Redis
# instead. Upstash's free tier (500K commands/month) is far more than enough.
# REDIS_URL=rediss://default:<password>@<host>:6379
# WHATSAPP_AUTH_STORE=redis   # redis | file | postgres (default: redis if REDIS_URL is set)
